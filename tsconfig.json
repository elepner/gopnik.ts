{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": ["oracle", "src", "test"]
}
